# Sprite 环境变量配置示例
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# vite 会自动加载 .env，修改后需重启 make dev
#
# 注意：所有 VITE_ 开头的变量会被打包进前端代码，不要在其中存放敏感信息
# API Key 仅用于本地开发，发布版本建议用户自行配置

# ============================================================
# 三个可选后端服务（不配置则对应按钮不显示，只用内置 LLM）
# 源码与部署说明见各项目 GitHub 仓库
# ============================================================

# resolve-studio 后端（Cordis agent 运行时，工具调用 + 沙箱）
# 项目地址：https://github.com/erishen/resolve-studio
VITE_RESOLVE_BASE_URL=http://127.0.0.1:8787

# spring-harness 后端（Spring AI Agent，ReAct 推理，SSE 流式）
# 项目地址：https://github.com/erishen/spring-harness
VITE_SPRING_BASE_URL=http://127.0.0.1:8080
# spring-harness 默认模型（必须显式传，否则后端默认模型可能不匹配）
VITE_SPRING_MODEL=your-model-name

# resolve-harness 后端（同步问答 + 工具 trace）
# 项目地址：https://github.com/erishen/resolve-harness
VITE_HARNESS_BASE_URL=http://127.0.0.1:8899
VITE_HARNESS_API_TOKEN=your-harness-token-here
VITE_HARNESS_MODEL=your-model-name

# ============================================================
# 内置 LLM（必配：三个后端都不可用时的 fallback，单独下载也能用）
# 任何 OpenAI 兼容 API 都支持（DeepSeek / OpenAI / 通义 / 本地 Ollama 等）
# ============================================================

# API 地址（OpenAI 兼容格式，如 https://api.example.com/v1）
# 已含 /v1 后缀时不会重复拼接，两种写法都支持
VITE_LLM_BASE_URL=https://api.example.com/v1
# API Key（必填，否则 🤖 按钮不显示）
VITE_LLM_API_KEY=your-api-key-here
# 模型名（填入你账号下可用的模型，如 deepseek-chat / gpt-4o / qwen-turbo 等）
VITE_LLM_MODEL=your-model-name

# ============================================================
# 发布说明
# ============================================================
# 1. 发布前请确保 .env 不被提交（已在 .gitignore 中忽略）
# 2. 发布版本中不包含任何 API Key，用户需自行配置
# 3. 所有数据本地存储，不上传任何服务器
# 4. 应用未经过苹果/微软公证，用户需手动允许打开
